# Prisma Database Connection
DATABASE_URL="YOUR_SUPABASE_DATABASE_URL"
DIRECT_URL="YOUR_SUPABASE_DIRECT_DATABASE_URL"

# Auth.js / NextAuth Configuration
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET"
# The canonical URL of your site
AUTH_URL="http://localhost:3000"

# Media Storage (UploadThing)
UPLOADTHING_TOKEN="YOUR_UPLOADTHING_TOKEN"
UPLOADTHING_SECRET="YOUR_UPLOADTHING_SECRET"
UPLOADTHING_APP_ID="YOUR_UPLOADTHING_APP_ID"

# Temporary Admin Auth Bypass (Local/Dev Only)
ADMIN_AUTH_DISABLED=false

# Real-time Lead Alerts (Optional: Discord, Slack, or Telegram webhook URL)
# Pings your phone instantly when a client books a call or submits an inquiry
LEAD_ALERT_WEBHOOK_URL=""

# Google Sheets / Excel Real-Time Sync (Optional: Google Apps Script Webhook or SheetDB/Zapier)
# Every form submission automatically appends a new row in your Google Sheet
GOOGLE_SHEET_WEBHOOK_URL=""
